  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/ui/*.tsx"
  },
  "scripts": {
    "build-storybook": "storybook build -o storybook-static",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
