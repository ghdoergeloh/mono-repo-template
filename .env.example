# Database (compose.yml reads POSTGRES_* on `docker compose up`;
# application code only reads DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=template
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/template

# Tests against a real PostgreSQL (locks, parallel transactions). Any
# database of a server where the user may create databases. Unset: those
# tests are skipped.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars
# The public origin of the app: where the browser loads the SPA and calls
# /api. In development that is the Vite dev server, which forwards /api to
# the API. In production the API serves the SPA itself (SPA_DIR).
BETTER_AUTH_URL=http://localhost:5173
# More origins that may call the API with a session (comma-separated).
# TRUSTED_ORIGINS=

# SMTP — Mailpit for development. With SMTP_HOST set, new accounts must
# verify their email address; without it, sign-up signs the user in.
# compose.yml exposes the SMTP listener on ${MAILPIT_PORT:-1025} and the
# inbox web UI on ${MAILPIT_WEB_PORT:-8025}. Override those here if the
# defaults clash with something else on your machine.
MAILPIT_PORT=1025
MAILPIT_WEB_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@localhost

# API
API_PORT=3000
# Directory of the built SPA. Set in the container image; leave it unset in
# development, where Vite serves the SPA.
# SPA_DIR=
