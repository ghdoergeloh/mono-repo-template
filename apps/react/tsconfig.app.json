{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "types": ["vite/client"],
    "tsBuildInfoFile": ".cache/tsbuildinfo.app.json"
  },
  "include": ["src"],
  // Tests run in Node.js (jsdom) and may use its APIs: tsconfig.test.json.
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "src/test"]
}
